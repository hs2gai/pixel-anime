// Cloudflare Workers（静的アセット配信）の設定。公開するのは build.py が書き出す dist/（publish.json の公開作品だけ）
// `pnpm cf:deploy` で書き出してから公開する。name は自分の Worker の名前に変える
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-anime",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist"
  },
  // 自分のドメインで公開するときは routes を足し、*.workers.dev の URL を閉じるなら workers_dev を false にする
  // "routes": [{ "pattern": "example.com/*", "zone_name": "example.com" }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": false }
}
